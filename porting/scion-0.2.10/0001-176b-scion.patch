new file mode 100644
index 00000000..2ddcf027
--- /dev/null
+++ b/src/kernels/cuda/lora_corr.cu
@@ -0,0 +1,155 @@
+// src/kernels/cuda/lora_corr.cu - the correction branch: round x to f16, t16 = f16(A x), out += B t16.
+//
+// The three passes, in order, are the reference `lora_corr_parity` mirrors and the one decode, prefill and
+// verify all share:
+//
+//   round  x -> x16 with the repo's RNE `f16_from_f32` (the A pass's operand rule; done once per x element,
+//          which is why it is a separate pass and not a per-multiply conversion in the hot loop).
+//   A      one BLOCK - four warps - per (row, output) pair; the reduction axis splits into four contiguous
+//          quarters of `n_in / 8` uint4 groups, each warp's lane l takes groups q0+l, q0+l+32, ... with the
+//          four accumulator chains of a 4x-unrolled loop (and acc0 for the tail), the partials combine as
+//          ((acc0+acc1)+(acc2+acc3)), then the 16/8/4/2/1 lane tree, then the four quarters LEFT TO RIGHT.
+//          `dot8` converts the f16 pairs with one hardware conversion each (`__half22float2`, exact for the
+//          f16 -> f32 direction) and accumulates in f32 in element order; the rounded f16 result is the
+//          kernel's only output.  **The previous form converted every element with the bit-exact scalar
+//          converter and was ALU-bound, not memory-bound: measured 69.6 -> 15.6 us on the ssm shape at
+//          rows=3, warm.**  The f32 -> f16 rounding that must stay bit-exact is in `f16_from_f32`.
+//   B      one WARP per (row, output) pair, lanes striding the reduction axis in uint4 groups of 8 f16,
+//          both operands f16 (`t16` from the A pass, B's own rows from the file).  The scalar f32-t form
+//          measured 28-43 us per branch at rows 3-5; this form 7-10 us.
+//
+// A is [rank, n_in] and B is [n_out, rank], both raw f16 rows.  n_in and rank must be multiples of 8 (uint4
+// rows); the validator refuses other geometries rather than mis-reading.
+#include "strata/kernels/lora_corr.hpp"
+
+#include "strata/kernels/f16_bits.hpp"
+
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+namespace strata::kernels {
+namespace {
+
+void check(const char* what) {
+    const cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e)); std::exit(1); }
+}
+
+constexpr int THREADS = 256;
+constexpr int WARPS = THREADS / 32;
+
+// Phase 1: one block per output, four warps splitting the reduction axis.  The order is fixed by
+// `lora_corr_parity`'s reference.
+constexpr int A_WARPS = 4;
+
+/// The A pass's 8-element product: the f16 pairs convert with one hardware instruction per pair and the
+/// eight products accumulate left to right in element order (f32).  The host reference writes the same
+/// eight `+=` statements against `f32_from_f16` values; keep the shapes in step.
+__device__ __forceinline__ float dot8(const uint4 av, const uint4 xv) {
+    const float2 a0 = __half22float2(*reinterpret_cast<const __half2*>(&av.x));
+    const float2 a1 = __half22float2(*reinterpret_cast<const __half2*>(&av.y));
+    const float2 a2 = __half22float2(*reinterpret_cast<const __half2*>(&av.z));
+    const float2 a3 = __half22float2(*reinterpret_cast<const __half2*>(&av.w));
+    const float2 x0 = __half22float2(*reinterpret_cast<const __half2*>(&xv.x));
+    const float2 x1 = __half22float2(*reinterpret_cast<const __half2*>(&xv.y));
+    const float2 x2 = __half22float2(*reinterpret_cast<const __half2*>(&xv.z));
+    const float2 x3 = __half22float2(*reinterpret_cast<const __half2*>(&xv.w));
+    float s = a0.x * x0.x;
+    s += a0.y * x0.y;
+    s += a1.x * x1.x;
+    s += a1.y * x1.y;
+    s += a2.x * x2.x;
+    s += a2.y * x2.y;
+    s += a3.x * x3.x;
+    s += a3.y * x3.y;
+    return s;
+}
+
+__global__ void lora_round_kernel(const float* __restrict__ x, uint16_t* __restrict__ x16, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) x16[i] = f16_from_f32(x[i]);
+}
+
+__global__ void lora_a_kernel(const uint16_t* __restrict__ a, const uint16_t* __restrict__ x16,
+                              uint16_t* __restrict__ t16, int64_t n_rows, int64_t n_in, int64_t rank) {
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int64_t i = blockIdx.x;                      // the output index (tok, r)
+    if (i >= n_rows * rank) return;
+    const int64_t tok = i / rank, r = i % rank;
+    const int64_t n8 = n_in / 8;                       // uint4 groups in the reduction axis
+    const uint16_t* row = a + (size_t) r * n_in;
+    const uint16_t* xr = x16 + (size_t) tok * n_in;
+    const uint4* rp = reinterpret_cast<const uint4*>(row);
+    const uint4* xp = reinterpret_cast<const uint4*>(xr);
+    const int64_t q0 = (n8 * warp) / A_WARPS;
+    const int64_t q1 = (n8 * (warp + 1)) / A_WARPS;
+    float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
+    int64_t k = q0 + lane;
+    for (; k + 96 < q1; k += 128) {
+        acc0 += dot8(rp[k], xp[k]);
+        acc1 += dot8(rp[k + 32], xp[k + 32]);
+        acc2 += dot8(rp[k + 64], xp[k + 64]);
+        acc3 += dot8(rp[k + 96], xp[k + 96]);
+    }
+    for (; k < q1; k += 32) acc0 += dot8(rp[k], xp[k]);
+    float acc = (acc0 + acc1) + (acc2 + acc3);
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, off);
+    __shared__ float part[A_WARPS];
+    if (lane == 0) part[warp] = acc;
+    __syncthreads();
+    if (threadIdx.x == 0) t16[(size_t) i] = f16_from_f32(((part[0] + part[1]) + part[2]) + part[3]);
+}
+
+// Phase 2: one WARP per (row, output) pair, lanes striding the reduction axis in uint4 groups.  Both
+// operands are already f16 (B's rows are the file's f16, `t16` is the A pass's rounded output), so the
+// pairs convert with one hardware instruction each and the loop is memory-shaped.  Measured against the
+// previous scalar form on this box: 28-43 us -> 7-10 us at rows 3-5.
+__global__ void lora_b_kernel(const uint16_t* __restrict__ b, const uint16_t* __restrict__ t16,
+                              float* __restrict__ out, int64_t n_rows, int64_t rank, int64_t n_out) {
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int64_t i = (int64_t) blockIdx.x * WARPS + warp;
+    if (i >= n_rows * n_out) return;
+    const int64_t tok = i / n_out, o = i % n_out;
+    const int64_t n8 = rank / 8;
+    const uint4* rp = reinterpret_cast<const uint4*>(b + (size_t) o * rank);
+    const uint4* tp = reinterpret_cast<const uint4*>(t16 + (size_t) tok * rank);
+    float acc = 0.0f;
+    for (int64_t k = lane; k < n8; k += 32) acc += dot8(rp[k], tp[k]);
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, off);
+    if (lane == 0) out[(size_t) tok * n_out + o] += acc;
+}
+
+}  // namespace
+
+void lora_corr_round_x(const float* x, uint16_t* x16, int64_t n, void* stream) {
+    if (x == nullptr || x16 == nullptr || n <= 0) return;
+    cudaStream_t s = (cudaStream_t) stream;
+    lora_round_kernel<<<(unsigned) ((n + THREADS - 1) / THREADS), THREADS, 0, s>>>(x, x16, n);
+    check("lora_corr_round_x");
+}
+
+void lora_corr_apply(const uint16_t* a, const uint16_t* b, const float* x, uint16_t* x16, uint16_t* t16, float* out,
+                     int64_t n_rows, int64_t n_in, int64_t rank, int64_t n_out, void* stream) {
+    if (a == nullptr || b == nullptr || n_rows <= 0) return;
+    cudaStream_t s = (cudaStream_t) stream;
+    // Chunked so a caller's x16 scratch is bounded by kLoraCorrRoundRows rows; stream order makes the
+    // reuse of the scratch between chunks safe.
+    for (int64_t r0 = 0; r0 < n_rows; r0 += kLoraCorrRoundRows) {
+        const int64_t rc = std::min(kLoraCorrRoundRows, n_rows - r0);
+        lora_corr_round_x(x + (size_t) r0 * n_in, x16, rc * n_in, stream);
+        const int64_t pa = rc * rank;
+        lora_a_kernel<<<(unsigned) pa, 32 * A_WARPS, 0, s>>>(a, x16, t16 + (size_t) r0 * rank, rc, n_in, rank);
+        check("lora_corr_apply/a");
+    }
+    const int64_t pb = n_rows * n_out;
+    lora_b_kernel<<<(unsigned) ((pb + WARPS - 1) / WARPS), THREADS, 0, s>>>(b, t16, out, n_rows, rank, n_out);
+    check("lora_corr_apply/b");
+}
+
+}  // namespace strata::kernels
diff --git a/src/kernels/f16_hw_check.cu b/src/kernels/f16_hw_check.cu
new file mode 100644
index 00000000..aeca099c
--- /dev/null
+++ b/src/kernels/f16_hw_check.cu
@@ -0,0 +1,193 @@
+// src/kernels/f16_hw_check.cu - do the hardware f16 conversions match the repo's bit-exact software ones?
+//
+// `f16_bits.hpp` documents that a hardware conversion returned wrong bits once (round 193) and the cause
+// was never isolated, so the repo uses software converters everywhere.  The correction kernels spend
+// ~75-80% of their time in them, so this check asks the question again, precisely: `__float2half_rn`
+// (ROUND-TO-NEAREST, which `__float2half` is NOT - it truncates) and `__half2float` against
+// `f16_from_f32`/`f32_from_f16`, bit for bit:
+//
+//   * widening: every one of the 65,536 fp16 codes, compared as f32 bits (inf/NaN included);
+//   * narrowing: a deterministic sweep of ~16M f32 bit patterns over the magnitude range 2^-44..2^44
+//     (which covers fp16 subnormals, normals and overflow), plus the boundary values and the specials.
+//
+// A mismatch prints the input, the two outputs, and exits nonzero.
+#include "strata/kernels/f16_bits.hpp"
+
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+
+namespace {
+
+__device__ __forceinline__ uint32_t f32_bits(float f) {
+    uint32_t u;
+    __builtin_memcpy(&u, &f, 4);
+    return u;
+}
+
+__device__ __forceinline__ uint16_t f16_bits_of(__half h) {
+    uint16_t b;
+    __builtin_memcpy(&b, &h, 2);
+    return b;
+}
+
+__global__ void widen_kernel(unsigned long long* mism, unsigned long long* nanpay, uint32_t* first_bad, uint32_t* first_hw) {
+    const uint32_t h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (h >= 65536u) return;
+    const uint16_t bits = (uint16_t) h;
+    const float sw = strata::kernels::f32_from_f16(bits);
+    __half hh;
+    memcpy(&hh, &bits, 2);
+    const float hw = __half2float(hh);
+    const uint32_t s = f32_bits(sw), w = f32_bits(hw);
+    if (s == w) return;
+    if (isnan(sw) && isnan(hw)) {   // both NaN: the payload differs, the value does not
+        atomicAdd(nanpay, 1ull);
+        return;
+    }
+    atomicAdd(mism, 1ull);
+    if (atomicCAS(first_bad, 0xFFFFFFFFu, h) == 0xFFFFFFFFu) *first_hw = w;
+}
+
+__device__ __forceinline__ float sweep_value(uint64_t i) {
+    // A deterministic spread: sign, mantissa, and an exponent over [-44, 44] - fp16 subnormals,
+    // normals, and the overflow boundary are all inside.
+    uint32_t u = (uint32_t) (i * 2654435761ull + 0x9E3779B9ull);
+    const int e = (int) ((u >> 20) % 89u) - 44;
+    const float m = 1.0f + (float) (u & 0x7FFFFFu) / 8388608.0f;
+    const float f = ldexpf(m, e);
+    return (u & 0x80000000u) ? -f : f;
+}
+
+__global__ void narrow_kernel(unsigned long long* mism, uint32_t* first_bad, uint16_t* first_hw, uint64_t n) {
+    const uint64_t i = (uint64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const float f = sweep_value(i);
+    const uint16_t sw = strata::kernels::f16_from_f32(f);
+    const uint16_t hw = f16_bits_of(__float2half_rn(f));
+    if (sw != hw) {
+        atomicAdd(mism, 1ull);
+        if (atomicCAS(first_bad, 0xFFFFFFFFu, f32_bits(f)) == 0xFFFFFFFFu) *first_hw = hw;
+    }
+}
+
+__device__ __forceinline__ uint16_t hw_narrow(float f) { return f16_bits_of(__float2half_rn(f)); }
+
+// The boundary and special values, one thread each.
+__global__ void targeted_kernel(const float* in, int n, unsigned long long* mism, unsigned long long* nanpay, int* which, uint16_t* first_hw) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const float f = in[i];
+    const uint16_t sw = strata::kernels::f16_from_f32(f);
+    const uint16_t hw = hw_narrow(f);
+    if (sw == hw) return;
+    if (isnan(f)) {   // NaN -> fp16 NaN: the payload differs, the value does not
+        atomicAdd(nanpay, 1ull);
+        return;
+    }
+    atomicAdd(mism, 1ull);
+    if (atomicCAS(which, -1, i) == -1) *first_hw = hw;
+}
+
+void check(const char* what) {
+    const cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e)); std::exit(1); }
+}
+
+uint32_t hbits(float f) {
+    uint32_t u;
+    memcpy(&u, &f, 4);
+    return u;
+}
+
+float from_bits(uint32_t u) {
+    float f;
+    memcpy(&f, &u, 4);
+    return f;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    const uint64_t n = argc > 1 ? strtoull(argv[1], nullptr, 0) : (1ull << 24);
+    unsigned long long* dm = nullptr;
+    unsigned long long* dnp = nullptr;
+    uint32_t* dbad = nullptr;
+    uint32_t* dbadhw = nullptr;
+    uint16_t* dbadhw16 = nullptr;
+    int* dwhich = nullptr;
+    cudaMalloc(&dm, 8);
+    cudaMalloc(&dnp, 8);
+    cudaMalloc(&dbad, 4);
+    cudaMalloc(&dbadhw, 4);
+    cudaMalloc(&dbadhw16, 2);
+    cudaMemset(dm, 0, 8);
+    cudaMemset(dnp, 0, 8);
+    cudaMemset(dbad, 0xFF, 4);
+    check("alloc");
+
+    widen_kernel<<<256, 256>>>(dm, dnp, dbad, dbadhw);
+    cudaDeviceSynchronize();
+    check("widen");
+    unsigned long long m = 0;
+    uint32_t bad = 0, badhw = 0;
+    cudaMemcpy(&m, dm, 8, cudaMemcpyDeviceToHost);
+    cudaMemcpy(&bad, dbad, 4, cudaMemcpyDeviceToHost);
+    cudaMemcpy(&badhw, dbadhw, 4, cudaMemcpyDeviceToHost);
+    if (m) {
+        std::printf("widen: %llu of 65536 differ, first 0x%04X: sw %08X hw %08X\n", m, (uint16_t) bad,
+                    hbits(strata::kernels::f32_from_f16((uint16_t) bad)), badhw);
+        return 1;
+    }
+    unsigned long long np = 0;
+    cudaMemcpy(&np, dnp, 8, cudaMemcpyDeviceToHost);
+    std::printf("widen:  65536 of 65536 fp16 codes -> f32 agree (%llu NaN-payload-only differences)\n", np);
+
+    cudaMemset(dm, 0, 8);
+    cudaMemset(dbad, 0xFF, 4);
+    narrow_kernel<<<(unsigned) ((n + 255) / 256), 256>>>(dm, dbad, dbadhw16, n);
+    cudaDeviceSynchronize();
+    check("narrow");
+    cudaMemcpy(&m, dm, 8, cudaMemcpyDeviceToHost);
+    cudaMemcpy(&bad, dbad, 4, cudaMemcpyDeviceToHost);
+    uint16_t bad16 = 0;
+    cudaMemcpy(&bad16, dbadhw16, 2, cudaMemcpyDeviceToHost);
+    if (m) {
+        std::printf("narrow: %llu of %llu differ, first %08X (%.9g): sw %04X hw %04X\n", m, n, bad,
+                    (double) from_bits(bad), strata::kernels::f16_from_f32(from_bits(bad)), bad16);
+        return 1;
+    }
+    std::printf("narrow: %llu of %llu sweep values -> fp16 agree\n", n, n);
+
+    const float edge[] = {0.0f, -0.0f, 1.0f, -1.0f,
+                          6.103515625e-05f, 6.097555160522461e-05f,   /* 2^-14, just below it */
+                          5.960464477539063e-08f, 2.9802322387695312e-08f,
+                          1.401298464324817e-45f,                    /* the smallest f32 subnormal */
+                          65504.0f, 65519.0f, 65520.0f, 65536.0f, 1e30f, -1e30f, INFINITY, -INFINITY, NAN};
+    const int ne = (int) (sizeof edge / sizeof edge[0]);
+    float* de = nullptr;
+    cudaMalloc(&de, sizeof edge);
+    cudaMemcpy(de, edge, sizeof edge, cudaMemcpyHostToDevice);
+    cudaMalloc(&dwhich, 4);
+    cudaMemset(dwhich, 0xFF, 4);
+    cudaMemset(dm, 0, 8);
+    targeted_kernel<<<1, 32>>>(de, ne, dm, dnp, dwhich, dbadhw16);
+    cudaDeviceSynchronize();
+    check("targeted");
+    cudaMemcpy(&m, dm, 8, cudaMemcpyDeviceToHost);
+    int which = 0;
+    cudaMemcpy(&which, dwhich, 4, cudaMemcpyDeviceToHost);
+    cudaMemcpy(&bad16, dbadhw16, 2, cudaMemcpyDeviceToHost);
+    if (m) {
+        std::printf("targeted: %llu of %d differ, first #%d %08X: sw %04X hw %04X\n", m, ne, which,
+                    hbits(edge[which]), strata::kernels::f16_from_f32(edge[which]), bad16);
+        return 1;
+    }
+    std::printf("targeted: %d boundary/special values agree\n", ne);
+    std::printf("f16_hw_check: PASS - the hardware conversions are bit-identical to f16_bits.hpp\n");
+    return 0;
+}
